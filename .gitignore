# Dune artifacts
_build/
dune.lock

# Local OPAM switch
_opam/

# VSCode user configuration
.vscode/

# Files that people sometimes accidentally include in their PRs
*:OECustomProperty

# TailwindCSS opam file, which appears to be generated by the build
tailwindcss.opam

# Scraper report files (generated by make scrape_ocaml_planet)
_scrape_commit.md
_scrape_report.md

# OCaml build artifacts outside _build/ (e.g. from ad-hoc ocamlc/utop runs in
# the tree). Dune output already lives under the ignored _build/, so these
# patterns only catch stray compilation products that would otherwise show up
# as untracked files at risk of being committed.
*.cmi
*.cmo
*.cmx
*.cmt
*.cmti
*.o
*.a
*.so
a.out
# ...except the in-browser playground, which ships prebuilt stdlib .cmi files.
!playground/asset/stdlib/*.cmi
