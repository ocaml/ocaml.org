let resource_link ~link icon title =
  <a href="<%s link %>" class="text-primary dark:text-dark-primary flex items-center dark:hover:text-dark-primary hover:underline group"> <%s! icon "h-5 w-5 mr-1 text-primary dark:text-dark-primary group-hover:text-primary group-hover-underline dark:group-hover:text-dark-primary" %><span><%s title %></span></a>

let hl ~search text =
  Search.highlight_search_terms
    ~class_:"bg-tertiary_lighter dark:bg-[#003357] dark:text-dark-white" ~search
    text

let render_blog_post ~search (post : Data.Planet.entry) =
  <div class="flex flex-col lg:flex-row lg:gap-12 dark:bg-dark-card dark:rounded-lg p-6 border-b border-separator_20 dark:border-none md:border-none mb-4">
      <div class="space-y-3 mt-2 lg:mt-0 flex flex-col flex-1">
          <a href="<%s match post with | BlogPost p -> p.url | Video v -> v.url %>"
              class="block text-xl text-title dark:text-dark-title hover:text-primary dark:hover:text-dark-primary"><%s! hl ~search (Data.Planet.entry_title post) %></a>
          <p class="text-content dark:text-dark-content truncate-2-lines">
              <%s! hl ~search (Data.Planet.entry_description post) %>
          </p>
          <% (match Data.Planet.entry_keywords post with [] -> () | keywords -> %>
          <div class="flex flex-wrap gap-1 text-sm">
            <% keywords |> List.iter (fun kw -> %>
              <a href="<%s Url.ocaml_planet %>?keyword=<%s Dream.to_percent_encoded kw %>"
                 class="px-2 whitespace-nowrap py-0.5 font-medium text-primary dark:text-dark-primary bg-primary_nav_block_hover_10 border border-primary dark:border-dark-primary rounded hover:bg-primary dark:hover:bg-dark-primary hover:text-white dark:hover:text-dark-white">
                <%s! hl ~search kw %>
              </a>
            <% ); %>
          </div>
          <% ); %>
          <div class="flex items-center flex-wrap gap-[4px]">
              <p class="text-content dark:text-dark-content text-sm mr-8 font-bold">
                <%s match post with | BlogPost p -> Utils.human_time p.date | Video v -> Utils.human_time v.published %>
              </p>
              <p class="text-content dark:text-dark-content font-bold text-sm mr-8">
                <%s match post with | BlogPost p -> p.source.name | Video v -> v.source_title %>
              </p>
              <% (match post with | BlogPost p -> %>
                <%s! resource_link ~link:p.url Icons.link "Read Article" %>
              <% | Video v -> %>
                <%s! resource_link ~link:v.url Icons.video "View Video" %>
              <% ); %>
          </div>
      </div>
      <div class="flex justify-center w-100 items-center mt-4 md:mt-4">
        <% (match post with | BlogPost p -> %>
          <% (match p.preview_image with | None -> %>                 
            <div class="w-full lg:w-[300px]">
                <a href="<%s p.url %>">
                  <div class="relative w-full h-[194px] overflow-hidden bg-event-5">
                    <div class="flex flex-col justify-center items-center z-10 absolute top-0 right-0 bottom-0 left-0">
                      <img class="w-[60px] mb-2" src="<%s! Ocamlorg_static.Asset.url "img/community/camel.svg" %>" alt="camel head illustration">
                      <p class="uppercase lg:text-4xl text-2xl tracking-widest text-white"> [ARTICLE]</p>
                    </div>
                    <div class="absolute inset-0 bg-[#C546000D] clip-triangle"></div>
                  </div>
                </a>
            </div>
          <% | Some image -> %>
              <div class="w-full lg:w-[300px]">
                  <a href="<%s p.url %>"><img class="w-full" src="<%s image %>" alt=""></a>
              </div>   
          <% ); %>
        <% | Video v -> %>
            <div class="w-full lg:w-[300px]">
                <a href="<%s v.url %>"><img class="w-full" src="<%s v.thumbnail %>" alt=""></a>
            </div>  
        <% ); %>
      </div>
  </div>

let render ?(category = "All") ~search ~(type_options : (string * string * bool) list) ~(facets : (string * (string * int * string * bool) list) list) ~(active_filters : (string * string * string) list) ~(hidden_params : (string * string) list) ~(pagination_info : Pagination.t) (planet : Data.Planet.entry list) =
News_layout.single_column_layout
~title:"The OCaml Planet"
~description:"The RSS aggregator for the OCaml community."
~canonical:(Url.ocaml_planet ^ if pagination_info.page_number = 1 then "" else "?p=" ^ string_of_int pagination_info.page_number)
~alternate:{ href = "/planet.xml"; title = "The OCaml Planet"; type_ = "application/atom+xml" }
~current:OCamlPlanet @@
<div class="bg-white dark:bg-dark-background py-12">
  <div class="container-fluid wide">
    <div class="grid grid:cols-1 lg:grid-cols-3 gap-4">
        <div class="col-span-1 lg:flex flex-col p-4 lg:order-2">
          <div class="border-b border-separator_20 dark:border-dark-separator_30 pb-4 mb-4">
            <p class="uppercase text-sm text-content dark:text-dark-content tracking-widest font-medium mb-2">Blog</p>
            <h1 class="font-bold text-2xl text-title dark:text-dark-title mb-2">
              The OCaml Planet
              <a href="/planet.xml" class="text-content dark:text-dark-title hover:text-primary dark:hover:text-dark-primary ml-4 lg:ml-6">
                <span class="sr-only">RSS</span>
                <%s! Icons.rss "h-6 w-6 md:h-8 md:w-8 lg:h-10 lg:w-10" %>
              </a>
            </h1>
            <p class="text-content dark:text-dark-content mb-4">
              Articles and videos contributed by both experts, companies and passionate developers from the OCaml community.
              From in-depth technical articles, project highlights, community news, or insights into Open Source projects,
              the OCaml Planet RSS feed aggregator has something for everyone.
            </p>
          </div>
          <div class="border-b border-separator_20 dark:border-dark-separator_30 pb-4 mb-4">
            <h3 class="font-bold text-sm uppercase tracking-widest text-content dark:text-dark-content mb-2">Type</h3>
            <div class="inline-flex rounded-md border border-primary dark:border-dark-primary overflow-hidden text-sm">
              <% type_options |> List.iteri (fun i (label, href, selected) -> %>
                <a href="<%s href %>"
                   class="px-3 py-1 <%s if i > 0 then "border-l border-primary dark:border-dark-primary" else "" %> <%s if selected then "bg-primary text-white dark:bg-dark-primary dark:text-dark-white" else "text-primary dark:text-dark-primary hover:bg-primary hover:text-white dark:hover:bg-dark-primary dark:hover:text-dark-white" %>"><%s label %></a>
              <% ); %>
            </div>
          </div>
          <% facets |> List.iter (fun (title, options) -> match options with [] -> () | _ -> %>
          <div class="border-b border-separator_20 dark:border-dark-separator_30 pb-4 mb-4">
            <h3 class="font-bold text-sm uppercase tracking-widest text-content dark:text-dark-content mb-2"><%s title %></h3>
            <div class="flex flex-wrap gap-1">
              <% options |> List.iter (fun (value, count, href, selected) -> %>
                <a href="<%s href %>"
                   class="px-2 py-0.5 text-sm rounded border <%s if selected then "bg-primary text-white border-primary dark:bg-dark-primary dark:text-dark-white" else "text-primary dark:text-dark-primary border-primary dark:border-dark-primary hover:bg-primary hover:text-white dark:hover:bg-dark-primary dark:hover:text-dark-white" %>">
                  <%s value %> <span class="opacity-60"><%i count %></span>
                </a>
              <% ); %>
            </div>
          </div>
          <% ); %>
          <div class="mt-4">
            <h2 class="font-bold text-2xl text-title dark:text-dark-title mb-2">Want your Blog Posts or Videos to Show Here?</h2>
            <p class="text-content dark:text-dark-content mb-2">
              To contribute a blog post, or add your RSS feed, check out the Contributing Guide on GitHub.
            </p>
            <div class="flex lg:flex-row mt-8 mr-4">
              <%s!  Hero_section.hero_button ~left_icon:(Icons.edit "w-6 h-6") ~right_icon:(Icons.link "w-5 h-5") ~text:("Add your RSS feed!") ~href:("https://github.com/ocaml/ocaml.org/blob/main/CONTRIBUTING.md#ocaml-planet") "" %>
             </div>
          </div>
        </div>
        <div class="col-span-2 lg:order-1">
          <div class="mt-2 mb-4">
            <form class="flex w-full" action="<%s Url.ocaml_planet %>" method="GET">
                  <%s! Forms.search_input
                    ~name:"q"
                    ~label:"Search the OCaml Planet"
                    ~button_attrs:{|type="submit"|}
                    ~input_attrs:("value=\"" ^ Dream.html_escape search ^ "\"")
                    "flex-1" %>
                  <%s! if category <> "All" then {|<input type="hidden" name="category" value="|} ^ Dream.html_escape category ^ {|">|} else "" %>
                  <% hidden_params |> List.iter (fun (k, v) -> %>
                    <input type="hidden" name="<%s k %>" value="<%s v %>">
                  <% ); %>
            </form>
          </div>
          <% (match active_filters with [] -> () | _ -> %>
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-sm text-content dark:text-dark-content">Filtering by:</span>
            <% active_filters |> List.iter (fun (label, value, remove_href) -> %>
              <a href="<%s remove_href %>"
                 class="inline-flex items-center gap-1 px-2 py-0.5 text-sm rounded border border-primary dark:border-dark-primary text-primary dark:text-dark-primary hover:bg-primary hover:text-white dark:hover:bg-dark-primary dark:hover:text-dark-white">
                <span class="font-medium"><%s label %>:</span> <%s value %>
                <span aria-hidden="true">&times;</span>
                <span class="sr-only">(remove)</span>
              </a>
            <% ); %>
            <a href="<%s Url.ocaml_planet %>" class="text-sm text-content dark:text-dark-content underline hover:text-primary dark:hover:text-dark-primary">Clear all</a>
          </div>
          <% ); %>
          <% (match planet with [] -> %>
            <div class="text-content dark:text-dark-content py-8">
              <p class="mb-2">We didn't find a match<% (if search <> "" then %> for "<%s search %>"<% ); %>.</p>
              <ul class="list-disc ml-6 space-y-1">
                <li>Try fewer or more general words, or remove a filter.</li>
                <li>Search matches post titles, keywords, descriptions, authors and sources.</li>
              </ul>
            </div>
          <% | _ -> %>
            <div class="flex flex-col">
              <%s! planet |> List.map (render_blog_post ~search) |> String.concat "\n" %>
            </div>
          <% ); %>
          <div class="flex items-start">
            <%s! Pagination.render pagination_info %> 
          </div>
        </div> 
    </div> 
  </div>
</div>














