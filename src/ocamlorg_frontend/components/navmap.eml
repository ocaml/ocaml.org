type kind =
  | Page
  | Library
  | Module
  | Leaf_page
  | Module_type
  | Parameter
  | Class
  | Class_type
  | File
  | Source

type toc = {
  title : string;
  kind : kind;
  href : string option;
  children : toc list
}

type t = toc list

let kind_title = function
  | Page -> "Page"
  | Library -> "Library"
  | Module -> "Module"
  | Module_type -> "Module type"
  | Parameter -> "Parameter"
  | Class -> "Class"
  | Class_type -> "Class type"
  | Source -> "Source"
  | _ -> "?"

let title_style = "flex-1 flex-nowrap py-1 md:py-0.5 pr-1 text-title dark:text-dark-title truncate"

let htmx_attributes = "hx-boost=\"true\" hx-ext=\"multi-swap\" hx-swap=\"multi:#htmx-head,#htmx-content,#htmx-right-sidebar,#htmx-breadcrumbs\" hx-push-url=\"true\""

let icon_style = function
  | Page -> "navmap-tag page-tag"
  | Library -> "navmap-tag library-tag"
  | Module -> "navmap-tag module-tag"
  | Module_type -> "navmap-tag module-type-tag"
  | Parameter -> "navmap-tag parameter-tag"
  | Class -> "navmap-tag class-tag"
  | Class_type -> "navmap-tag class-type-tag"
  | Source -> "navmap-tag source-tag"
  | _ -> "navmap-tag"

let id_of_path path = path |> List.map (fun x -> Format.sprintf "%S" (Base64.encode_string x)) |> String.concat ", "

(* The tree is rendered without any knowledge of the current page, so that one
   rendering serves every page of a package version: it is fetched by the page
   as a separate, cacheable fragment (see [render_placeholder]). Everything
   that depends on the current page -- highlighting the active path, opening
   the branch that leads to it, and only listing a module-less library while
   no other library is selected -- is decided client-side by Alpine from the
   [active] array that the placeholder provides. *)
let on_active_path = "idPath.every((v, i) => v === active[i])"

let rec nested_render ~prefix_path (item : toc) =
  let prefix_path = item.title :: prefix_path in
  let id_path = id_of_path (List.rev prefix_path) in
  match item.children with
  | [] ->
    let active_style = "bg-gray-200 dark:bg-dark-tertiary_bt_hover font-medium" in
    (* [active[0]] is the library of the current page, or "" on an .mld page. *)
    let leaf_library_visibility =
      if item.kind = Library then
        " x-show=\"!active.length || active[0] === '' || active[0] === idPath[0]\""
      else ""
    in
    <div x-data='{idPath:[<%s! id_path %>]}'<%s! leaf_library_visibility %> class="box-border border pl-1 ml-1 border-transparent" :class="{ '<%s active_style %>' : <%s on_active_path %>}">
      <div class="flex flex-nowrap" title="<%s kind_title item.kind ^ " " ^ item.title %>">
        <% (match item.href with | None -> %>
          <span class="no-expand"><span class="<%s icon_style item.kind %>" :class="<%s on_active_path %> ? '' : 'opacity-80'"></span></span>
          <span class="sm <%s title_style %>"><%s! item.title %></span>
        <% | Some href -> %>
        <a href="<%s href %>" x-on:click="open = true ; active = idPath" <%s! htmx_attributes %> class="flex">
        <span class="no-expand"><span class="<%s icon_style item.kind %>" :class="<%s on_active_path %> ? '' : 'opacity-80'"></span></span>
        </a>
        <a href="<%s href %>" x-on:click="open = true ; active = idPath" <%s! htmx_attributes %> class="<%s title_style %> overflow-hidden truncate text-title dark:text-dark-title transition-colors hover:text-primary">
          <%s! item.title %>
        </a>
        <% ); %>
      </div>
    </div>
  | children ->
    (* Small libraries start open; the branch leading to the current page is
       opened on load, and on an .mld page every top-level entry is. *)
    let open_by_default = item.kind = Library && (List.length children <= 2) in
    let active_style = "bg-gray-100 dark:bg-dark-tertiary_bt_hover font-medium dark:font-semibold" in
    <div x-data='{idPath:[<%s! id_path %>], open: <%s if open_by_default then "true" else "false" %>}' x-init="open = open || (active[0] === '' ? idPath.length === 1 : <%s on_active_path %>)">
      <div class="box-border border border-transparent cursor-pointer pl-1 ml-1" :class="{ 'nav-expand': open, '<%s active_style %>' : <%s on_active_path %>}">
        <div class="flex flex-nowrap items-center" title="<%s kind_title item.kind ^ " " ^ item.title %>">
          <span class="icon-expand" x-on:click="open = ! open" :class="open ? 'open' : ''" >
            <span class="<%s icon_style item.kind %>" :class="<%s on_active_path %> ? '' : 'opacity-80'"></span>
          </span>
          <% (match item.href with | None -> %>
            <span x-on:click="open = ! open" class="<%s title_style %>" :class="<%s on_active_path %> ? 'white-200' : 'gray-900'">
              <%s! item.title %> 
            </span>
            <span x-on:click="open = ! open" class="arrow-expand mr-2" :class="open ? 'open' : ''"><%s! Icons.chevron_down "h-5 w-5" %></span>
          <% | Some href -> %>
          <a href="<%s href %>" x-on:click="open = true ; active = idPath" <%s! htmx_attributes %> class="<%s title_style %> overflow-hidden truncate text-title dark:text-dark-title transition-colors hover:text-primary">
            <%s! item.title %>
          </a>
          <span x-on:click="open = ! open" class="sign-expand mr-2" :class="open ? 'open' : ''"></span>
          <% ); %>
        </div>
      </div>
      <ul x-show="open" class="ml-2.5 border-l border-white transition-colors">
        <% children |> List.iter begin fun item -> %>
          <li>
            <%s! nested_render ~prefix_path item %>
          </li>
        <% end; %>
      </ul>
    </div>

(* The page-independent sidebar fragment for a package version: served from
   its own URL ([Url.Package.documentation_sidebar]) with a cache lifetime, so
   Varnish and browsers serve it for every page of the package instead of the
   backend rendering, copying and compressing the whole module tree (often
   megabytes) into every documentation page. *)
let render_tree
~(package: Package.package)
?hash
(maptoc : t)
=
  let version = Package.url_version package in
  <% (match maptoc with [] ->  %>
  <span class="block py-2 text-gray-700">Package contains no libraries</span>
  <% | _ -> %>
    <a class="py-1 font-medium text-content dark:text-dark-content hover:text-primary dark:hover:text-dark-primary transition-colors" href="<%s Url.Package.documentation ?hash ?version package.name %>">
      package <%s package.name %>
    </a>
  <ul>
    <% maptoc |> List.iter begin fun item -> %>
    <li class="pl-0.5">
      <%s! nested_render ~prefix_path:[] item %>
    </li>
    <% end; %>
  </ul>
  <div class="py-24 text-title dark:text-dark-title">
  Legend:<br>
  <span class="<%s icon_style Page %>" style="display:inline-block;color:white"></span>Page<br>
  <span class="<%s icon_style Library %>" style="display:inline-block;color:white"></span>Library<br>
  <span class="<%s icon_style Module %>" style="display:inline-block;color:white"></span>Module<br>
  <span class="<%s icon_style Module_type %>" style="display:inline-block;color:white"></span>Module type<br>
  <span class="<%s icon_style Parameter %>" style="display:inline-block;color:white"></span>Parameter<br>
  <span class="<%s icon_style Class %>" style="display:inline-block;color:white"></span>Class<br>
  <span class="<%s icon_style Class_type %>" style="display:inline-block;color:white"></span>Class type<br>
  <span class="<%s icon_style Source %>" style="display:inline-block;color:white"></span>Source
  </div>
  <% ); %>

(* What a documentation page embeds instead of the tree: the current page's
   path for Alpine, and an htmx trigger that loads the shared fragment. htmx's
   in-page navigation does not swap this element, so the fragment is fetched
   once per full page load, and from the browser cache after that. *)
let render_placeholder
~(package: Package.package)
?hash
~path
()
=
  let version = Package.url_version package in
  <div x-cloak class="navmap pb-12" x-data='{active:[<%s! id_of_path path %>]}' hx-get="<%s Url.Package.documentation_sidebar ?hash ?version package.name %>" hx-trigger="load" hx-swap="innerHTML"></div>
