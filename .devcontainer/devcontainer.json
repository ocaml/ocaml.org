{
    "name": "OCaml.org",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "cacheFrom": "ghcr.io/ocaml/ocaml.org-dev:main"
    },
    "customizations": {
        "vscode": {
            "extensions": ["ocamllabs.ocaml-platform"]
        }
    },
    "containerUser": "opam",
    "forwardPorts": [8080],
    "onCreateCommand": "opam install --deps-only --with-doc --with-test --yes ."
}
