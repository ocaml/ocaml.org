; Toplevel worker: the js_of_ocaml-toplevel worker, with the compiler but
; without the stdlib .cmi files, which it fetches from stdlib.cmis.js.

(executable
 (name worker)
 (modes byte)
 (modules worker)
 (link_flags
  (:standard -linkall))
 (libraries js_of_ocaml-toplevel.worker compiler-libs.toplevel))

(rule
 (targets worker.js)
 (action
  (run
   %{bin:js_of_ocaml}
   --toplevel
   --no-cmis
   --effects=cps
   --opt
   3
   %{dep:worker.bc}
   -o
   %{targets})))

(rule
 (targets stdlib.cmis.js)
 (action
  (run jsoo_mkcmis -o %{targets} stdlib)))

; Merlin worker

(executable
 (name merlin_worker)
 (modes js)
 (modules merlin_worker)
 (libraries merlin-js.worker))

; Playground

(executable
 (name main)
 (modes js)
 (modules
  (:standard \ worker merlin_worker))
 (libraries
  brr
  code-mirror
  merlin-js.code-mirror
  lwt
  js_of_ocaml-toplevel.protocol
  js_of_ocaml-toplevel.worker_lwt_client))
