(using directory-targets 0.1)

(name ocamlorg-playground)

(documentation "https://ocaml.github.io/ocaml.org/")

(source
 (github ocaml/ocaml.org))

(license ISC)

(authors
 "Thibaut Mattio"
 "Lucas Pluvinage"
 "Patrick Ferris"
 "Ashish Agarwal"
 "Kanishka Azimi"
 "Richard Davison"
 "Jiae Kam")

(maintainers "Thibaut Mattio" "Patrick Ferris")

(generate_opam_files true)

(using mdx 0.1)

(package
 (name ocamlorg-playground)
 (synopsis "Playground for the official OCaml website")
 (description
  "This repository contains the playground served on https://ocaml.org/play.")
 (allow_empty)
 (depends
  (ocaml
   (and
    (>= 5.5)
    (< 5.6)))
  (brr
   (>= 0.0.6))
  esbuild
  (js_of_ocaml
   (>= 6.5.0))
  (js_of_ocaml-lwt
   (>= 6.5.0))
  (js_of_ocaml-toplevel
   (>= 6.5.0))
  lwt
  ; UPSTREAM: built from the vendor/merlin-js submodule (see vendor/dune).
  ; Once merlin-js and code-mirror can be installed together, replace these
  ; with code-mirror and merlin-js, and their pins in the opam template.
  merlin-lib
  js_of_ocaml-ppx))
